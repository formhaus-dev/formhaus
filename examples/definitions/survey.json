{
  "id": "product-survey",
  "formatVersion": "1.3",
  "title": "Product survey",
  "submit": { "label": "Send answers" },
  "steps": [
    {
      "id": "welcome",
      "title": "Help us improve Formhaus",
      "description": "Four short questions. It takes about two minutes.",
      "next": { "label": "Start" },
      "fields": []
    },
    {
      "id": "recommend",
      "title": "Recommend",
      "next": false,
      "fields": [
        {
          "key": "nps",
          "type": "scale",
          "label": "How likely are you to recommend us to a friend or colleague?",
          "autoAdvance": true,
          "validation": { "required": true, "min": 0, "max": 10 },
          "options": [{ "value": "0", "label": "Not at all likely" }, { "value": "10", "label": "Extremely likely" }]
        }
      ]
    },
    {
      "id": "details",
      "title": "A bit more",
      "fields": [
        {
          "key": "improve",
          "type": "textarea",
          "label": "What should we improve first?",
          "rows": 3,
          "show": [{ "field": "nps", "lte": 6 }]
        },
        {
          "key": "support",
          "type": "rating",
          "label": "How would you rate our support?",
          "validation": { "required": true }
        },
        {
          "key": "device",
          "type": "radio",
          "label": "Where do you build forms most often?",
          "options": [
            {
              "value": "laptop",
              "label": "Laptop",
              "image": "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=480&h=360&fit=crop&auto=format&q=70"
            },
            {
              "value": "desktop",
              "label": "Desktop",
              "image": "https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=480&h=360&fit=crop&auto=format&q=70"
            },
            {
              "value": "tablet",
              "label": "Tablet",
              "image": "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=480&h=360&fit=crop&auto=format&q=70"
            }
          ]
        },
        {
          "key": "agree",
          "type": "section",
          "layout": "matrix",
          "title": "How much do you agree?",
          "fields": [
            {
              "key": "easy",
              "type": "radio",
              "label": "The editor is easy to use",
              "options": [
                { "value": "disagree", "label": "Disagree" },
                { "value": "neutral", "label": "Neutral" },
                { "value": "agree", "label": "Agree" }
              ]
            },
            {
              "key": "docs",
              "type": "radio",
              "label": "The docs answer my questions",
              "options": [
                { "value": "disagree", "label": "Disagree" },
                { "value": "neutral", "label": "Neutral" },
                { "value": "agree", "label": "Agree" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
