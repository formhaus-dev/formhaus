{
  "name": "@formhaus/react",
  "version": "0.14.2",
  "description": "Render multi-step, conditional and branching forms in React from a JSON form definition. Native inputs or your own components.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "default": "./dist/cloud.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:resolve": "node --input-type=module -e \"import('./dist/index.js').then(m => { if (!m.FormRenderer) process.exit(1); console.log('ESM resolve OK'); })\"",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@formhaus/core": "^0.14.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@formhaus/core": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "i18next": "^26.4.2",
    "jsdom": "^29.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.3"
  },
  "license": "MIT",
  "homepage": "https://formhaus.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignsm/formhaus.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ignsm/formhaus/issues"
  },
  "keywords": [
    "form",
    "forms",
    "form-definition",
    "json-form",
    "form-renderer",
    "multi-step-form",
    "wizard",
    "conditional-fields",
    "conditional-logic",
    "branching",
    "validation",
    "headless-form",
    "form-engine",
    "form-builder",
    "survey",
    "quiz",
    "typescript",
    "react",
    "react-form",
    "react-component"
  ]
}
