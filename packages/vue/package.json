{
  "name": "@formhaus/vue",
  "version": "0.16.0",
  "description": "Render multi-step, conditional and branching forms in Vue 3 from a JSON form definition. Native inputs or your own components.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "default": "./dist/cloud.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@formhaus/core": "^0.17.0",
    "vue": "^3.3.3"
  },
  "devDependencies": {
    "@formhaus/core": "workspace:*",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.13"
  },
  "license": "MIT",
  "homepage": "https://formhaus.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignsm/formhaus.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/ignsm/formhaus/issues"
  },
  "keywords": [
    "form",
    "forms",
    "form-definition",
    "json-form",
    "form-renderer",
    "multi-step-form",
    "wizard",
    "conditional-fields",
    "conditional-logic",
    "branching",
    "validation",
    "headless-form",
    "form-engine",
    "form-builder",
    "survey",
    "quiz",
    "typescript",
    "vue",
    "vue3",
    "vue-form"
  ]
}
