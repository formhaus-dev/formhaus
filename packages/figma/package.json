{
  "name": "@formhaus/figma",
  "version": "0.3.1",
  "private": true,
  "description": "Figma plugin: generates form mockups from @formhaus/core form definitions",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "test:watch": "vitest",
    "build:harness": "node build.mjs --harness"
  },
  "dependencies": {
    "@formhaus/core": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formhaus-dev/formhaus.git",
    "directory": "packages/figma"
  },
  "bugs": {
    "url": "https://github.com/formhaus-dev/formhaus/issues"
  },
  "homepage": "https://formhaus.dev"
}
