{
  "name": "@formhaus/editor-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js"
    },
    "./style.css": "./dist/style.css",
    "./mount.css": "./dist/mount.css",
    "./preview.css": "./dist/preview.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:browser": "vitest run --project browser --project engines"
  },
  "peerDependencies": {
    "@formhaus/builder": "workspace:*",
    "@formhaus/core": "workspace:^",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "@lezer/highlight": "^1.0.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "get-nonce": "^1.0.0",
    "immer": "^11.0.0",
    "lucide-react": "^1.55.0"
  },
  "devDependencies": {
    "@formhaus/builder": "workspace:*",
    "@formhaus/core": "workspace:*",
    "@formhaus/react": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.0.2",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formhaus-dev/formhaus.git",
    "directory": "packages/editor-react"
  },
  "bugs": {
    "url": "https://github.com/formhaus-dev/formhaus/issues"
  },
  "homepage": "https://formhaus.dev"
}
