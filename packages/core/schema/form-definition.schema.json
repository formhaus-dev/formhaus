{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://formhaus.dev/schema/form-definition.json",
  "title": "Formhaus form definition",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "string",
      "description": "Format version of the definition, such as \"1.0\". Core rejects a newer major version.",
      "pattern": "^[1-9]\\d*(\\.\\d+)?$"
    },
    "id": {
      "type": "string",
      "description": "Unique form identifier."
    },
    "lang": {
      "type": "string",
      "description": "Language of the texts, a BCP 47 tag such as \"en\" or \"pt-BR\". Renderers set it as the lang attribute of the form."
    },
    "title": {
      "type": "string",
      "description": "Form title for host UI and Figma output. Renderers do not display it."
    },
    "description": {
      "type": "string",
      "description": "Plain text shown under the title by the host UI and Figma output. Renderers do not display it. Up to 1000 characters.",
      "maxLength": 1000
    },
    "messages": {
      "$ref": "#/definitions/MessageCatalog",
      "description": "Validation message templates by message key. {min} and {max} are replaced. Field-level messages win over these."
    },
    "labels": {
      "$ref": "#/definitions/LabelCatalog",
      "description": "Renderer label templates: continue, back, stepOf ({current}, {total}) and errorSummary."
    },
    "i18n": {
      "$ref": "#/definitions/FormI18n",
      "description": "Translation keys for the form texts and the messages and labels catalogs, resolved by the app translate function."
    },
    "submit": {
      "$ref": "#/definitions/FormAction",
      "description": "Submit button on the last step."
    },
    "cancel": {
      "$ref": "#/definitions/FormAction",
      "description": "Optional cancel button."
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FormField"
      },
      "description": "Fields of a single-step form."
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FormStep"
      },
      "description": "Steps of a multi-step form. FormEngine rejects a definition with both non-empty fields and steps."
    }
  },
  "required": [
    "id",
    "title",
    "submit"
  ],
  "additionalProperties": false,
  "description": "A Formhaus form. Use fields for a single-step form or steps for a multi-step form, not both.",
  "definitions": {
    "MessageCatalog": {
      "type": "object",
      "properties": {
        "required": {
          "type": "string",
          "minLength": 1
        },
        "minLength": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "string",
          "minLength": 1
        },
        "minItems": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "string",
          "minLength": 1
        },
        "max": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "matchField": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "datetime": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "option": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "string",
          "minLength": 1
        },
        "boolean": {
          "type": "string",
          "minLength": 1
        },
        "string": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "LabelCatalog": {
      "type": "object",
      "properties": {
        "continue": {
          "type": "string",
          "minLength": 1
        },
        "back": {
          "type": "string",
          "minLength": 1
        },
        "stepOf": {
          "type": "string",
          "minLength": 1
        },
        "errorSummary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FormI18n": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "$ref": "#/definitions/MessageCatalog"
        },
        "labels": {
          "$ref": "#/definitions/LabelCatalog"
        }
      },
      "additionalProperties": false
    },
    "FormAction": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "text"
          ]
        },
        "disabled": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          }
        },
        "i18n": {
          "$ref": "#/definitions/LabelI18n",
          "description": "Translation key for the button label."
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "ShowCondition": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "description": "Key of the field to check."
        },
        "eq": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Matches when the value strictly equals this."
        },
        "neq": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Matches when the value does not strictly equal this."
        },
        "in": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Matches when the value is one of these."
        },
        "notIn": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Matches when the value is none of these."
        },
        "notEmpty": {
          "type": "boolean",
          "description": "Matches when the value is not undefined, null, an empty string or an empty array."
        },
        "gt": {
          "type": "number",
          "description": "Matches when the value is a number, or a numeric string, greater than this."
        },
        "gte": {
          "type": "number",
          "description": "Matches when the value is a number, or a numeric string, greater than or equal to this."
        },
        "lt": {
          "type": "number",
          "description": "Matches when the value is a number, or a numeric string, less than this."
        },
        "lte": {
          "type": "number",
          "description": "Matches when the value is a number, or a numeric string, less than or equal to this."
        }
      },
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "description": "A condition on another field value. Use exactly one operator: eq, neq, in, notIn, notEmpty, gt, gte, lt or lte.",
      "minProperties": 2,
      "maxProperties": 2
    },
    "LabelI18n": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FormField": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Key of the field value in the submitted values. Unique within the form.",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "type": {
          "$ref": "#/definitions/FieldType",
          "description": "Field type. A built-in type or a custom type rendered through the renderer components prop."
        },
        "label": {
          "type": "string",
          "description": "Label text."
        },
        "placeholder": {
          "type": "string"
        },
        "helperText": {
          "type": "string",
          "description": "Hint text between the label and the control."
        },
        "autoAdvance": {
          "type": "boolean",
          "description": "Moves to the next step when the field is committed: a built-in radio on click, Space or Enter, or a custom field calling onCommit. The last step never auto-submits."
        },
        "defaultValue": {
          "description": "Initial value. Also the value restored on reset or skip."
        },
        "show": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Field is visible only when all conditions match. Hidden fields are cleared, not validated and not submitted."
        },
        "showAny": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Field is visible when any condition matches."
        },
        "validation": {
          "$ref": "#/definitions/FieldValidation",
          "description": "Validation rules checked on Continue and on submit, not on blur."
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldOption"
          },
          "description": "Static options for select, autocomplete, multiselect and radio fields."
        },
        "layout": {
          "type": "string",
          "enum": [
            "stack",
            "inline"
          ],
          "description": "Option layout for radio and multiselect fields. stack (default) lists options vertically. inline places short options side by side and wraps them."
        },
        "optionsFrom": {
          "type": "string",
          "description": "Key of an options provider passed to the renderer, used instead of static options."
        },
        "optionsDependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accept": {
          "type": "string"
        },
        "rows": {
          "type": "number"
        },
        "mask": {
          "type": "string"
        },
        "inputMode": {
          "type": "string",
          "enum": [
            "text",
            "numeric",
            "decimal",
            "tel",
            "email",
            "url",
            "search"
          ]
        },
        "i18n": {
          "$ref": "#/definitions/FieldI18n",
          "description": "Translation keys for label, placeholder and helperText. The literal texts stay the fallback."
        }
      },
      "required": [
        "key",
        "type",
        "label"
      ],
      "additionalProperties": false
    },
    "FieldType": {
      "anyOf": [
        {
          "$ref": "#/definitions/DefaultFieldType"
        },
        {
          "type": "string"
        }
      ]
    },
    "DefaultFieldType": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "phone",
        "number",
        "password",
        "select",
        "autocomplete",
        "multiselect",
        "checkbox",
        "radio",
        "switch",
        "file",
        "date",
        "datetime",
        "time",
        "textarea",
        "hidden"
      ]
    },
    "FieldValidation": {
      "type": "object",
      "properties": {
        "required": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "minLength": {
          "type": "number"
        },
        "minLengthMessage": {
          "type": "string"
        },
        "maxLength": {
          "type": "number"
        },
        "maxLengthMessage": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "minMessage": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "maxMessage": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "patternMessage": {
          "type": "string"
        },
        "matchField": {
          "type": "string",
          "description": "Key of another field whose value this field must equal."
        },
        "matchFieldMessage": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "i18n": {
          "$ref": "#/definitions/ValidationI18n",
          "description": "Translation keys for the messages of the validation rules, by rule name."
        }
      },
      "additionalProperties": false
    },
    "ValidationI18n": {
      "type": "object",
      "properties": {
        "required": {
          "type": "string",
          "minLength": 1
        },
        "minLength": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "string",
          "minLength": 1
        },
        "max": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "matchField": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FieldOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "i18n": {
          "$ref": "#/definitions/LabelI18n",
          "description": "Translation key for the option label."
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "FieldI18n": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "helperText": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FormStep": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StepRoute"
          },
          "description": "Forward destinations checked in order. The first match with a visible target wins. With no match, navigation continues to the next visible step."
        },
        "id": {
          "type": "string",
          "description": "Unique step identifier, used as a route target. FormEngine rejects duplicates."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FormField"
          }
        },
        "show": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Step is visible only when all conditions match. Hidden steps are skipped and not submitted."
        },
        "showAny": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Step is visible when any condition matches."
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/definitions/FormAction"
            },
            {
              "type": "boolean",
              "const": false
            }
          ],
          "description": "Overrides the Continue button. false hides it."
        },
        "back": {
          "anyOf": [
            {
              "$ref": "#/definitions/FormAction"
            },
            {
              "type": "boolean",
              "const": false
            }
          ],
          "description": "Overrides the Back button. false hides it."
        },
        "skip": {
          "$ref": "#/definitions/FormAction",
          "description": "Shows a Skip button that resets the step fields and moves forward without validation."
        },
        "i18n": {
          "$ref": "#/definitions/StepI18n",
          "description": "Translation keys for the step title and description. The literal texts stay the fallback."
        }
      },
      "required": [
        "id",
        "title",
        "fields"
      ],
      "additionalProperties": false
    },
    "StepRoute": {
      "type": "object",
      "properties": {
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of a later step. null makes the current step the last one on this path."
        },
        "show": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Route matches only when all conditions match. Without show or showAny the route always matches."
        },
        "showAny": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowCondition"
          },
          "description": "Route matches when any condition matches."
        }
      },
      "required": [
        "to"
      ],
      "additionalProperties": false,
      "description": "A forward destination for a step."
    },
    "StepI18n": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
