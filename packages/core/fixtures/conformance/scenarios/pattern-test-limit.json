                "validation": {
                  "pattern": "^x$"
                }
              }
            ]
          },
          {
            "key": "last",
            "type": "text",
            "label": "Last",
            "defaultValue": "x",
            "validation": {
              "pattern": "^x$"
            }
          }
        ]
      },
      "steps": [
        {
          "do": "validate",
          "returns": {}
        },
        {
          "do": "validate",
          "returns": {}
        }
      ]
    }
  ]
}
