{
  "$schema": "./scenario.schema.json",
  "name": "routes",
  "definition": {
    "id": "routes",
    "title": "Account",
    "submit": {
      "label": "Save"
    },
    "steps": [
      {
        "id": "kind",
        "title": "Kind",
        "fields": [
          {
            "key": "kind",
            "type": "radio",
            "label": "Kind",
            "validation": {
              "required": true
            },
            "autoAdvance": true
          },
          {
            "key": "enabled",
            "type": "checkbox",
            "label": "Enabled"
          }
        ],
        "routes": [
          {
            "to": "business",
            "show": [
              {
                "field": "kind",
                "eq": "business"
              }
            ]
          },
          {
            "to": "personal"
          }
        ]
      },
      {
        "id": "business",
        "title": "Business",
        "fields": [
          {
            "key": "company",
            "type": "text",
            "label": "Company",
            "validation": {
              "required": true
            }
          }
        ],
        "routes": [
          {
            "to": "review"
          }
        ]
      },
      {
        "id": "personal",
        "title": "Personal",
        "fields": [
          {
            "key": "name",
            "type": "text",
            "label": "Name",
            "validation": {
              "required": true
            }
          }
        ],
        "routes": [
          {
            "to": "review"
          }
        ]
      },
      {
        "id": "review",
        "title": "Review",
        "fields": []
      }
    ]
  },
  "scenarios": [
    {
      "name": "uses ordered predicates, fallback and explicit convergence for progress and Back",
      "values": {
        "kind": "business",
        "company": "Acme"
      },
      "steps": [
        {
          "expect": {
            "steps": ["kind", "business", "review"],
            "progress": {
              "current": 1,
              "total": 3
            }
          }
        },
        {
          "do": "next",
          "returns": true
        },
        {
          "expect": {
            "step": "business"
          }
        },
        {
          "do": "next",
          "returns": true
        },
        {
          "expect": {
            "step": "review"
          }
        },
        {
          "do": "back",
          "returns": true
        },
        {
          "expect": {
            "step": "business"
          }
        },
        {
          "do": "back"
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "personal"
        },
        {
          "do": "next",
          "returns": true
        },
        {
          "expect": {
            "step": "personal"
          }
        }
      ]
    },
    {
      "name": "retains skipped answers but omits them from validation, hooks and payload",
      "values": {
        "kind": "business",
        "company": "Acme",
        "name": ""
      },
      "hooks": {
        "onBeforeStepChange": []
      },
      "steps": [
        {
          "do": "validate",
          "returns": {}
        },
        {
          "expect": {
            "submitValues": {
              "kind": "business",
              "company": "Acme"
            }
          }
        },
        {
          "do": "next"
        },
        {
          "expect": {
            "log": [
              {
                "call": "onBeforeStepChange",
                "context": {
                  "fromStepId": "kind",
                  "toStepId": "business",
                  "reason": "next",
                  "values": {
                    "kind": "business",
                    "company": "Acme"
                  }
                }
              },
              {
                "event": {
                  "type": "step_completed",
                  "stepId": "kind"
                }
              }
            ]
          }
        },
        {
          "do": "submit",
          "handler": []
        },
        {
          "expect": {
            "log": [
              {
                "event": {
                  "type": "form_submitted",
                  "fieldCount": 2
                }
              },
              {
                "call": "submit",
                "values": {
                  "kind": "business",
                  "company": "Acme"
                },
                "skippedSteps": []
              },
              {
                "event": {
                  "type": "form_submit_succeeded"
                }
              }
            ]
          }
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "personal"
        },
        {
          "expect": {
            "step": "kind",
            "values": {
              "kind": "personal",
              "company": "Acme",
              "name": ""
            }
          }
        },
        {
          "do": "validate",
          "returns": {
            "name": "This field is required"
          }
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "business"
        },
        {
          "expect": {
            "submitValues": {
              "kind": "business",
              "company": "Acme"
            }
          }
        }
      ]
    },
    {
      "name": "reconciles from an obsolete branch to the nearest common predecessor",
      "values": {
        "kind": "business",
        "company": "Acme"
      },
      "steps": [
        {
          "do": "next",
          "returns": true
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "personal"
        },
        {
          "expect": {
            "step": "kind",
            "stepIndex": 0
          }
        },
        {
          "do": "next",
          "returns": true
        },
        {
          "expect": {
            "step": "personal"
          }
        }
      ]
    },
    {
      "name": "drops pending validation when changing an answer changes the path",
      "values": {
        "kind": "business"
      },
      "hooks": {
        "onBeforeStepChange": [
          {
            "defer": "gate"
          }
        ]
      },
      "steps": [
        {
          "do": "next",
          "await": false,
          "returns": false
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "personal"
        },
        {
          "do": "resolve",
          "deferred": "gate"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "step": "kind",
            "steps": ["kind", "personal", "review"]
          }
        }
      ]
    },
    {
      "name": "discards a pending submission when a route answer switches branches",
      "values": {
        "kind": "personal",
        "name": "Ada",
        "company": "Retained"
      },
      "hooks": {
        "onBeforeSubmit": [
          {
            "defer": "allow"
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "step": "kind"
          }
        },
        {
          "do": "submit",
          "await": false,
          "handler": [],
          "returns": false
        },
        {
          "do": "setValue",
          "key": "kind",
          "value": "business"
        },
        {
          "do": "resolve",
          "deferred": "allow"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "log": [
              {
                "call": "onBeforeSubmit",
                "values": {
                  "kind": "personal",
                  "name": "Ada"
                }
              }
            ]
          }
        }
      ]
    },
    {
