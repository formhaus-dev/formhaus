    {
      "name": "supports showAny, default-next when no route matches, and explicit terminal steps",
      "definition": {
        "id": "routes",
        "title": "Account",
        "submit": {
          "label": "Save"
        },
        "steps": [
          {
            "id": "kind",
            "title": "Kind",
            "fields": [
              {
                "key": "kind",
                "type": "radio",
                "label": "Kind",
                "validation": {
                  "required": true
                },
                "autoAdvance": true
              },
              {
                "key": "enabled",
                "type": "checkbox",
                "label": "Enabled"
              }
            ],
            "routes": [
              {
                "to": "personal",
                "showAny": [
                  {
                    "field": "kind",
                    "eq": "personal"
                  }
                ]
              }
            ]
          },
          {
            "id": "business",
            "title": "Business",
            "fields": [
              {
                "key": "company",
                "type": "text",
                "label": "Company",
                "validation": {
                  "required": true
                }
              }
            ],
            "routes": [
              {
                "to": null
              }
            ]
          },
          {
            "id": "personal",
            "title": "Personal",
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name",
                "validation": {
                  "required": true
                }
              }
            ],
            "routes": [
              {
                "to": "review"
              }
            ]
          },
          {
            "id": "review",
            "title": "Review",
            "fields": []
          }
        ]
      },
      "values": {
        "kind": "business",
        "company": "Acme"
      },
      "steps": [
        {
          "expect": {
            "steps": ["kind", "business"]
          }
        },
        {
          "do": "next"
        },
        {
          "expect": {
            "isLastStep": true
          }
        },
        {
          "do": "next",
          "returns": false
        }
      ]
    },
