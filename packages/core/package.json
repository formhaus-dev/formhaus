{
  "name": "@formhaus/core",
  "version": "0.11.0",
  "description": "JSON form definition engine: validation, conditional visibility, multi-step and branching routes. Zero dependencies, works in React, Vue, Svelte or vanilla.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/server.iife.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./server.iife.js": "./dist/server.iife.js",
    "./style.css": "./style.css",
    "./schema.json": "./schema/form-definition.schema.json",
    "./fixtures/submissions/*": "./fixtures/submissions/*",
    "./fixtures/cloud/*": "./fixtures/cloud/*"
  },
  "files": [
    "dist",
    "fixtures/submissions",
    "fixtures/cloud",
    "schema",
    "style.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:resolve": "node --input-type=module -e \"import('./dist/index.js').then(m => { if (!m.FormEngine) process.exit(1); console.log('ESM resolve OK'); })\"",
    "clean": "rm -rf dist",
    "schema": "node scripts/schema.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "homepage": "https://formhaus.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignsm/formhaus.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ignsm/formhaus/issues"
  },
  "keywords": [
    "form",
    "forms",
    "form-definition",
    "json-form",
    "form-renderer",
    "multi-step-form",
    "wizard",
    "conditional-fields",
    "conditional-logic",
    "branching",
    "validation",
    "headless-form",
    "form-engine",
    "form-builder",
    "survey",
    "quiz",
    "typescript",
    "framework-agnostic"
  ]
}
