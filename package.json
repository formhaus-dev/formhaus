{
  "private": true,
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "scripts": {
    "build": "pnpm -r run build",
    "docs:install": "pnpm --dir docs install --frozen-lockfile",
    "docs:build": "pnpm docs:install && pnpm --dir docs run build",
    "docs:dev": "pnpm --dir docs run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "clean": "pnpm -r run clean",
    "lint:packages": "pnpm --filter @formhaus/core --filter @formhaus/react --filter @formhaus/vue --filter @formhaus/mcp exec publint",
    "check:types": "pnpm --filter @formhaus/core --filter @formhaus/react --filter @formhaus/vue --filter @formhaus/mcp exec attw --pack --profile esm-only --exclude-entrypoints ./style.css ./server.iife.js && node scripts/check-consumer-types.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:builder-isolation": "node scripts/check-builder-isolation.mjs",
    "check:migration": "node scripts/check-migration.mjs",
    "templates": "node scripts/templates-index.mjs",
    "templates:check": "node scripts/templates-index.mjs --check",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-mcp-server-json.mjs",
    "release": "pnpm build && changeset publish",
    "check:build-page": "node scripts/check-build-page.mjs",
    "check:docs-bundle": "node scripts/check-docs-bundle.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "og:images": "node scripts/og-images.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.31.0",
    "esbuild": "0.25.12",
    "publint": "^0.3.18"
  }
}
