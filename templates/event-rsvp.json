{
  "slug": "event-rsvp",
  "title": "Event RSVP",
  "summary": "Yes or no first. Guests and dietary needs only appear for people who are coming.",
  "category": "registration",
  "definition": {
    "id": "event-rsvp",
    "formatVersion": "1.1",
    "title": "RSVP",
    "submit": { "label": "Send RSVP" },
    "steps": [
      {
        "id": "reply",
        "title": "Your reply",
        "fields": [
          {
            "key": "name",
            "type": "text",
            "label": "Full name",
            "validation": { "required": true }
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email",
            "inputMode": "email",
            "validation": { "required": true }
          },
          {
            "key": "attending",
            "type": "radio",
            "label": "Will you be there?",
            "options": [{ "value": "yes", "label": "Yes, I’ll be there" }, { "value": "no", "label": "Sorry, I can’t make it" }],
            "validation": { "required": true }
          }
        ]
      },
      {
        "id": "details",
        "title": "Your party",
        "show": [{ "field": "attending", "eq": "yes" }],
        "fields": [
          { "key": "dietary", "type": "text", "label": "Any dietary needs for you?" },
          {
            "key": "guests",
            "type": "group",
            "label": "Who else is coming?",
            "itemLabel": "Guest {index}",
            "addLabel": "Add a guest",
            "defaultItems": 0,
            "validation": { "maxLength": 9 },
            "fields": [
              {
                "key": "guestName",
                "type": "text",
                "label": "Full name",
                "validation": { "required": true }
              },
              { "key": "guestDiet", "type": "text", "label": "Dietary needs" }
            ]
          },
          { "key": "note", "type": "textarea", "label": "A note for the hosts", "rows": 3 }
        ]
      }
    ]
  }
}
