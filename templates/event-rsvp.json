{
  "slug": "event-rsvp",
  "title": "Event RSVP",
  "summary": "Yes or no first. Party size and dietary needs only appear for guests who are coming.",
  "category": "registration",
  "definition": {
    "id": "event-rsvp",
    "title": "RSVP",
    "submit": { "label": "Send RSVP" },
    "steps": [
      {
        "id": "reply",
        "title": "Your reply",
        "fields": [
          {
            "key": "name",
            "type": "text",
            "label": "Full name",
            "validation": { "required": true }
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email",
            "inputMode": "email",
            "validation": { "required": true }
          },
          {
            "key": "attending",
            "type": "radio",
            "label": "Will you be there?",
            "options": [
              { "value": "yes", "label": "Yes, I’ll be there" },
              { "value": "no", "label": "Sorry, I can’t make it" }
            ],
            "validation": { "required": true }
          }
        ]
      },
      {
        "id": "details",
        "title": "Your party",
        "show": [{ "field": "attending", "eq": "yes" }],
        "fields": [
          {
            "key": "partySize",
            "type": "number",
            "label": "How many people, including you?",
            "inputMode": "numeric",
            "defaultValue": 1,
            "validation": { "required": true, "min": 1, "max": 10 }
          },
          { "key": "dietary", "type": "text", "label": "Dietary requirements in your party" },
          { "key": "note", "type": "textarea", "label": "A note for the hosts", "rows": 3 }
        ]
      }
    ]
  }
}
