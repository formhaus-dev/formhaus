{
  "slug": "team-pulse-survey",
  "title": "Team pulse survey",
  "summary": "A one-minute anonymous check-in: eNPS, workload, clarity, manager support and recognition.",
  "category": "survey",
  "definition": {
    "id": "team-pulse-survey",
    "formatVersion": "1.3",
    "title": "Team pulse",
    "description": "Your answers are anonymous. It takes about a minute.",
    "submit": { "label": "Send answers" },
    "fields": [
      {
        "key": "enps",
        "type": "scale",
        "label": "How likely are you to recommend this team as a place to work?",
        "validation": { "required": true, "min": 0, "max": 10 },
        "options": [{ "value": "0", "label": "Not at all likely" }, { "value": "10", "label": "Extremely likely" }]
      },
      {
        "key": "workload",
        "type": "radio",
        "label": "How is your workload?",
        "options": [
          { "value": "too-much", "label": "Far too much" },
          { "value": "bit-much", "label": "A bit too much" },
          { "value": "right", "label": "About right" },
          { "value": "room", "label": "I could take on more" }
        ],
        "validation": { "required": true }
      },
      {
        "key": "agreement",
        "type": "section",
        "layout": "matrix",
        "title": "How much do you agree?",
        "fields": [
          {
            "key": "clarity",
            "type": "radio",
            "label": "I know what is expected of me",
            "options": [
              { "value": "1", "label": "Strongly disagree" },
              { "value": "2", "label": "Disagree" },
              { "value": "3", "label": "Neutral" },
              { "value": "4", "label": "Agree" },
              { "value": "5", "label": "Strongly agree" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "support",
            "type": "radio",
            "label": "I get the support I need from my manager",
            "options": [
              { "value": "1", "label": "Strongly disagree" },
              { "value": "2", "label": "Disagree" },
              { "value": "3", "label": "Neutral" },
              { "value": "4", "label": "Agree" },
              { "value": "5", "label": "Strongly agree" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "recognition",
            "type": "radio",
            "label": "Good work gets recognized here",
            "options": [
              { "value": "1", "label": "Strongly disagree" },
              { "value": "2", "label": "Disagree" },
              { "value": "3", "label": "Neutral" },
              { "value": "4", "label": "Agree" },
              { "value": "5", "label": "Strongly agree" }
            ],
            "validation": { "required": true }
          }
        ]
      },
      {
        "key": "oneThing",
        "type": "textarea",
        "label": "One thing that would make next month better",
        "rows": 3,
        "helperText": "Leave out names and details that could identify you."
      }
    ]
  }
}
