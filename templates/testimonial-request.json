{
  "slug": "testimonial-request",
  "title": "Testimonial request",
  "summary": "Collects a short quote, the result a client got and permission to publish it.",
  "category": "feedback",
  "definition": {
    "id": "testimonial-request",
    "formatVersion": "1.3",
    "title": "Share your experience",
    "submit": { "label": "Send testimonial" },
    "steps": [
      {
        "id": "story",
        "title": "Your experience",
        "fields": [
          {
            "key": "before",
            "type": "textarea",
            "label": "What was the situation before you worked with us?",
            "rows": 3
          },
          {
            "key": "result",
            "type": "textarea",
            "label": "What changed for you?",
            "rows": 3,
            "validation": { "required": true }
          },
          {
            "key": "rating",
            "type": "rating",
            "label": "How would you rate working with us?",
            "options": [{ "value": "1", "label": "Poor" }, { "value": "5", "label": "Excellent" }]
          },
          {
            "key": "quote",
            "type": "textarea",
            "label": "Your testimonial in a sentence or two",
            "rows": 3,
            "validation": { "required": true, "maxLength": 400 }
          }
        ]
      },
      {
        "id": "you",
        "title": "About you",
        "fields": [
          {
            "key": "permission",
            "type": "radio",
            "label": "How can we use your testimonial?",
            "options": [
              { "value": "full", "label": "With my name, title and company" },
              { "value": "first-name", "label": "With my first name only" },
              { "value": "anonymous", "label": "Without my name" },
              { "value": "private", "label": "Please don’t publish it" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "name",
            "type": "text",
            "label": "Full name",
            "show": [{ "field": "permission", "in": ["full", "first-name"] }],
            "validation": { "required": true }
          },
          { "key": "jobTitle", "type": "text", "label": "Job title", "show": [{ "field": "permission", "eq": "full" }] },
          { "key": "company", "type": "text", "label": "Company", "show": [{ "field": "permission", "eq": "full" }] },
          {
            "key": "photo",
            "type": "file",
            "label": "Headshot",
            "accept": "image/*",
            "helperText": "Optional. Only if you’re happy for us to publish it with your testimonial.",
            "show": [{ "field": "permission", "eq": "full" }]
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email",
            "inputMode": "email",
            "helperText": "Only if we should send you the final version to approve."
          }
        ]
      }
    ]
  }
}
