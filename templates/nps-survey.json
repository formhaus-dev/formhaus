        "validation": { "required": true }
      },
      {
        "key": "fix",
        "type": "textarea",
        "label": "What’s the main thing we should improve?",
        "rows": 3,
        "show": [{ "field": "score", "in": ["0", "1", "2", "3", "4", "5", "6"] }]
