{
  "slug": "nps-survey",
  "title": "NPS survey",
  "summary": "The standard 0 to 10 recommend question with a follow-up that changes with the score.",
  "category": "feedback",
  "definition": {
    "id": "nps-survey",
    "formatVersion": "1.3",
    "title": "Quick question",
    "submit": { "label": "Send feedback" },
    "fields": [
      {
        "key": "score",
        "type": "scale",
        "label": "How likely are you to recommend us to a friend or colleague?",
        "validation": { "required": true, "min": 0, "max": 10 },
        "options": [{ "value": "0", "label": "Not at all likely" }, { "value": "10", "label": "Extremely likely" }]
      },
      {
        "key": "fix",
        "type": "textarea",
        "label": "What’s the main thing we should improve?",
        "rows": 3,
        "show": [{ "field": "score", "lte": 6 }]
      },
      {
        "key": "missing",
        "type": "textarea",
        "label": "What would make it a 10?",
        "rows": 3,
        "show": [{ "field": "score", "gte": 7 }, { "field": "score", "lte": 8 }]
      },
      { "key": "love", "type": "textarea", "label": "What do you value most?", "rows": 3, "show": [{ "field": "score", "gte": 9 }] }
    ]
  }
}
