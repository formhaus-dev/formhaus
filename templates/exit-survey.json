{
  "slug": "exit-survey",
  "title": "Exit survey",
  "summary": "Why people leave, how their time went and whether they would return. Every question is optional.",
  "category": "survey",
  "definition": {
    "id": "exit-survey",
    "formatVersion": "1.3",
    "title": "Exit survey",
    "description": "It takes about 4 minutes. Every question is optional.",
    "submit": { "label": "Send answers" },
    "steps": [
      {
        "id": "reasons",
        "title": "Why you’re leaving",
        "fields": [
          {
            "key": "tenure",
            "type": "radio",
            "label": "How long have you worked here?",
            "options": [
              { "value": "lt1", "label": "Under 1 year" },
              { "value": "1-3", "label": "1 year to under 3" },
              { "value": "3-5", "label": "3 years to under 5" },
              { "value": "5-plus", "label": "5 years or more" }
            ]
          },
          {
            "key": "mainReason",
            "type": "radio",
            "label": "What’s the main reason you’re leaving?",
            "options": [
              { "value": "pay", "label": "Pay or benefits" },
              { "value": "growth", "label": "Career growth or promotion" },
              { "value": "manager", "label": "My manager" },
              { "value": "workload", "label": "Workload or hours" },
              { "value": "work", "label": "The work itself" },
              { "value": "culture", "label": "Team or culture" },
              { "value": "flexibility", "label": "Location or remote work" },
              { "value": "personal", "label": "Family or personal reasons" },
              { "value": "health", "label": "Health" },
              { "value": "study", "label": "Going back to study" },
              { "value": "retirement", "label": "Retirement" },
              { "value": "other", "label": "Something else" }
            ]
          },
          {
            "key": "mainOther",
            "type": "text",
            "label": "What’s the main reason?",
            "validation": { "required": true },
            "show": [{ "field": "mainReason", "eq": "other" }]
          },
          {
            "key": "otherReasons",
            "type": "multiselect",
            "label": "Did anything else play a part?",
            "helperText": "Choose all that apply, besides your main reason.",
            "options": [
              { "value": "pay", "label": "Pay or benefits" },
              { "value": "growth", "label": "Career growth or promotion" },
              { "value": "manager", "label": "My manager" },
              { "value": "workload", "label": "Workload or hours" },
              { "value": "work", "label": "The work itself" },
              { "value": "culture", "label": "Team or culture" },
              { "value": "flexibility", "label": "Location or remote work" },
              { "value": "personal", "label": "Family or personal reasons" },
              { "value": "health", "label": "Health" },
              { "value": "study", "label": "Going back to study" },
              { "value": "retirement", "label": "Retirement" },
              { "value": "other", "label": "Something else" }
            ]
          }
        ]
      },
      {
        "id": "experience",
        "title": "Your time here",
        "fields": [
          {
            "key": "experienceAgree",
            "type": "section",
            "layout": "matrix",
            "title": "How much do you agree?",
            "fields": [
              {
                "key": "tools",
                "type": "radio",
                "label": "I had what I needed to do my job well",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              },
              {
                "key": "managerSupport",
                "type": "radio",
                "label": "My manager supported me",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              },
              {
                "key": "fairPay",
                "type": "radio",
                "label": "My pay was fair for the work",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              },
              {
                "key": "learning",
                "type": "radio",
                "label": "I had chances to learn and grow",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              },
              {
                "key": "respect",
                "type": "radio",
                "label": "I was treated with respect",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              },
              {
                "key": "manageable",
                "type": "radio",
                "label": "My workload was manageable",
                "options": [
                  { "value": "1", "label": "Strongly disagree" },
                  { "value": "2", "label": "Disagree" },
                  { "value": "3", "label": "Neutral" },
                  { "value": "4", "label": "Agree" },
                  { "value": "5", "label": "Strongly agree" },
                  { "value": "na", "label": "Not applicable" }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "next",
        "title": "Looking back",
        "fields": [
          {
            "key": "keep",
            "type": "textarea",
            "label": "What could we have done to keep you?",
            "rows": 3,
            "show": [
              {
                "field": "mainReason",
                "notIn": ["retirement"]
              }
            ]
          },
          {
            "key": "nextStep",
            "type": "radio",
            "label": "What’s next for you?",
            "options": [
              { "value": "job", "label": "A job at another company" },
              { "value": "own", "label": "Starting my own business" },
              { "value": "study", "label": "Study" },
              { "value": "break", "label": "Taking a break" },
              { "value": "retire", "label": "Retiring" },
              { "value": "unsure", "label": "Not sure yet" }
            ]
          },
          {
            "key": "appeal",
            "type": "textarea",
            "label": "What made the new job more appealing?",
            "rows": 3,
            "show": [{ "field": "nextStep", "eq": "job" }]
          },
          {
            "key": "return",
            "type": "radio",
            "label": "Would you consider working here again?",
            "layout": "inline",
            "options": [{ "value": "yes", "label": "Yes" }, { "value": "maybe", "label": "Maybe" }, { "value": "no", "label": "No" }]
          },
          { "key": "anything", "type": "textarea", "label": "Anything else you want us to know?", "rows": 3 }
        ]
      }
    ]
  }
}
