{
  "slug": "event-feedback",
  "title": "Event feedback",
  "summary": "Overall rating, best session, highlights, what to change and whether people would come again.",
  "category": "feedback",
  "definition": {
    "id": "event-feedback",
    "formatVersion": "1.4",
    "title": "Event feedback",
    "submit": { "label": "Send feedback" },
    "fields": [
      {
        "key": "rating",
        "type": "rating",
        "label": "How would you rate the event overall?",
        "validation": { "required": true },
        "options": [{ "value": "1", "label": "Poor" }, { "value": "5", "label": "Excellent" }]
      },
      {
        "key": "attended",
        "type": "radio",
        "label": "How did you attend?",
        "layout": "inline",
        "options": [{ "value": "in-person", "label": "In person" }, { "value": "online", "label": "Online" }],
        "validation": { "required": true }
      },
      {
        "key": "venueRating",
        "type": "rating",
        "label": "How would you rate the venue?",
        "show": [{ "field": "attended", "eq": "in-person" }],
        "options": [{ "value": "1", "label": "Poor" }, { "value": "5", "label": "Excellent" }]
      },
      {
        "key": "cateringRating",
        "type": "rating",
        "label": "How would you rate the food and drinks?",
        "helperText": "Skip this if there was no food or drinks.",
        "show": [{ "field": "attended", "eq": "in-person" }],
        "options": [{ "value": "1", "label": "Poor" }, { "value": "5", "label": "Excellent" }]
      },
      {
        "key": "highlights",
        "type": "multiselect",
        "label": "What did you enjoy most?",
        "helperText": "Pick all that apply.",
        "options": [
          { "value": "talks", "label": "Talks" },
          { "value": "workshops", "label": "Workshops" },
          { "value": "networking", "label": "Networking" },
          { "value": "organization", "label": "Organization" },
          { "value": "other", "label": "Something else" }
        ]
      },
      {
        "key": "highlightsOther",
        "type": "text",
        "label": "What else did you enjoy?",
        "show": [{ "field": "highlights", "contains": "other" }],
        "validation": { "required": true }
      },
      { "key": "bestSession", "type": "text", "label": "Which session was most useful?" },
      { "key": "change", "type": "textarea", "label": "What should we change next time?", "rows": 3 },
      {
        "key": "return",
        "type": "radio",
        "label": "Would you come again?",
        "layout": "inline",
        "options": [{ "value": "yes", "label": "Yes" }, { "value": "maybe", "label": "Maybe" }, { "value": "no", "label": "No" }]
      },
      { "key": "updates", "type": "checkbox", "label": "Tell me about future events" },
      {
        "key": "email",
        "type": "email",
        "label": "Email",
        "inputMode": "email",
        "validation": { "required": true },
        "show": [{ "field": "updates", "eq": true }]
      }
    ]
  }
}
