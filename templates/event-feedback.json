{
  "slug": "event-feedback",
  "title": "Event feedback",
  "summary": "Overall rating, highlights, what to change and whether people would come again.",
  "category": "feedback",
  "definition": {
    "id": "event-feedback",
    "title": "Event feedback",
    "submit": { "label": "Send feedback" },
    "steps": [
      {
        "id": "overall",
        "title": "Overall",
        "fields": [
          {
            "key": "rating",
            "type": "radio",
            "label": "How would you rate the event overall?",
            "options": [
              { "value": "1", "label": "Poor" },
              { "value": "2", "label": "Fair" },
              { "value": "3", "label": "Good" },
              { "value": "4", "label": "Very good" },
              { "value": "5", "label": "Excellent" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "attended",
            "type": "radio",
            "label": "How did you attend?",
            "layout": "inline",
            "options": [
              { "value": "in-person", "label": "In person" },
              { "value": "online", "label": "Online" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "highlights",
            "type": "multiselect",
            "label": "What did you enjoy most?",
            "helperText": "Pick all that apply.",
            "options": [
              { "value": "talks", "label": "Talks" },
              { "value": "workshops", "label": "Workshops" },
              { "value": "networking", "label": "Networking" },
              { "value": "venue", "label": "Venue" },
              { "value": "food", "label": "Food and drinks" },
              { "value": "organization", "label": "Organization" },
              { "value": "other", "label": "Something else" }
            ]
          }
        ]
      },
      {
        "id": "details",
        "title": "Next time",
        "fields": [
          {
            "key": "change",
            "type": "textarea",
            "label": "What should we change next time?",
            "rows": 3
          },
          {
            "key": "return",
            "type": "radio",
            "label": "Would you come again?",
            "layout": "inline",
            "options": [
              { "value": "yes", "label": "Yes" },
              { "value": "maybe", "label": "Maybe" },
              { "value": "no", "label": "No" }
            ],
            "validation": { "required": true }
          },
          {
            "key": "updates",
            "type": "switch",
            "label": "Tell me about future events",
            "defaultValue": false
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email",
            "inputMode": "email",
            "validation": { "required": true },
            "show": [{ "field": "updates", "eq": true }]
          }
        ]
      }
    ]
  }
}
