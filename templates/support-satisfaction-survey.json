{
  "slug": "support-satisfaction-survey",
  "title": "Support satisfaction survey",
  "summary": "Resolution, CSAT and customer effort after a support conversation, with a follow-up when it went badly.",
  "category": "feedback",
  "definition": {
    "id": "support-satisfaction-survey",
    "title": "How did we do?",
    "submit": { "label": "Send feedback" },
    "fields": [
      {
        "key": "resolved",
        "type": "radio",
        "label": "Was your issue resolved?",
        "layout": "inline",
        "options": [
          { "value": "yes", "label": "Yes" },
          { "value": "partly", "label": "Partly" },
          { "value": "no", "label": "No" }
        ],
        "validation": { "required": true }
      },
      {
        "key": "csat",
        "type": "radio",
        "label": "How satisfied are you with the help you got?",
        "layout": "inline",
        "helperText": "1 means very dissatisfied, 5 means very satisfied.",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" },
          { "value": "3", "label": "3" },
          { "value": "4", "label": "4" },
          { "value": "5", "label": "5" }
        ],
        "validation": { "required": true }
      },
      {
        "key": "effort",
        "type": "radio",
        "label": "We made it easy for you to handle your issue",
        "layout": "inline",
        "helperText": "1 means strongly disagree, 7 means strongly agree.",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" },
          { "value": "3", "label": "3" },
          { "value": "4", "label": "4" },
          { "value": "5", "label": "5" },
          { "value": "6", "label": "6" },
          { "value": "7", "label": "7" }
        ]
      },
      {
        "key": "improve",
        "type": "textarea",
        "label": "What could we have done better?",
        "rows": 3,
        "showAny": [
          { "field": "csat", "in": ["1", "2", "3"] },
          { "field": "resolved", "in": ["partly", "no"] }
        ]
      }
    ]
  }
}
