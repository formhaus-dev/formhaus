{
  "slug": "support-satisfaction-survey",
  "title": "Support satisfaction survey",
  "summary": "Resolution, CSAT and customer effort after a support conversation, with a follow-up when it went badly.",
  "category": "feedback",
  "definition": {
    "id": "support-satisfaction-survey",
    "formatVersion": "1.3",
    "title": "How did we do?",
    "submit": { "label": "Send feedback" },
    "fields": [
      {
        "key": "resolved",
        "type": "radio",
        "label": "Was your issue resolved?",
        "layout": "inline",
        "options": [{ "value": "yes", "label": "Yes" }, { "value": "partly", "label": "Partly" }, { "value": "no", "label": "No" }],
        "validation": { "required": true }
      },
      {
        "key": "csat",
        "type": "rating",
        "label": "How satisfied are you with the help you got?",
        "validation": { "required": true },
        "options": [{ "value": "1", "label": "Very dissatisfied" }, { "value": "5", "label": "Very satisfied" }]
      },
      {
        "key": "effort",
        "type": "scale",
        "label": "We made it easy for you to handle your issue",
        "validation": { "max": 7 },
        "options": [{ "value": "1", "label": "Strongly disagree" }, { "value": "7", "label": "Strongly agree" }]
      },
      {
        "key": "improve",
        "type": "textarea",
        "label": "What could we have done better?",
        "rows": 3,
        "showAny": [{ "field": "csat", "lte": 3 }, { "field": "resolved", "in": ["partly", "no"] }]
      }
    ]
  }
}
