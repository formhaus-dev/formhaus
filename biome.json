{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/dist",
      "!templates/index.json",
      "!packages/core/schema",
      "!docs/public/schema",
      "!packages/mcp/server.json",
      "!**/*.css",
      "!**/*.html",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noPrototypeBuiltins": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["packages/core/fixtures/conformance/contains-limit.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.vue", "**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/engine/runtime.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedPrivateClassMembers": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            "noDynamicNamespaceImportAccess": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/react-shadcn/src/components/ui/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/editor-react/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useFocusableInteractive": "off",
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/editor-react/src/**/*.tsx",
        "!packages/editor-react/src/ui/**",
        "!packages/editor-react/src/test/**",
        "!**/*.test.tsx",
        "!packages/editor-react/src/canvas/ButtonsCard.tsx",
        "!packages/editor-react/src/canvas/FieldCard.tsx",
        "!packages/editor-react/src/canvas/FieldDetails.tsx",
        "!packages/editor-react/src/canvas/FieldPalette.tsx",
        "!packages/editor-react/src/canvas/FieldPreview.tsx",
        "!packages/editor-react/src/canvas/GoTo.tsx",
        "!packages/editor-react/src/canvas/HiddenValue.tsx",
        "!packages/editor-react/src/canvas/InsertGap.tsx",
        "!packages/editor-react/src/canvas/MatrixPreview.tsx",
        "!packages/editor-react/src/canvas/OptionsEditor.tsx",
        "!packages/editor-react/src/canvas/RequiredTag.tsx",
        "!packages/editor-react/src/canvas/StepHeaderCard.tsx",
        "!packages/editor-react/src/canvas/TypeChip.tsx",
        "!packages/editor-react/src/inspector/FieldPanel.tsx",
        "!packages/editor-react/src/inspector/PerRow.tsx",
        "!packages/editor-react/src/inspector/ResponseKey.tsx",
        "!packages/editor-react/src/inspector/StepPanel.tsx",
        "!packages/editor-react/src/json/JsonIssues.tsx",
        "!packages/editor-react/src/json/JsonPane.tsx",
        "!packages/editor-react/src/logic/LogicBadge.tsx",
        "!packages/editor-react/src/logic/LogicSection.tsx",
        "!packages/editor-react/src/logic/StepFlow.tsx",
        "!packages/editor-react/src/outline/StepOutline.tsx",
        "!packages/editor-react/src/publish/IssueList.tsx",
        "!packages/editor-react/src/publish/PublishButton.tsx",
        "!packages/editor-react/src/publish/PublishControls.tsx",
        "!packages/editor-react/src/root/Notices.tsx",
        "!packages/editor-react/src/shell/EditorSaveStatus.tsx",
        "!packages/editor-react/src/shell/EditorTopBar.tsx",
        "!packages/editor-react/src/shell/EditorView.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "Use a shared component from packages/editor-react/src/ui",
                  "input": "Use a shared component from packages/editor-react/src/ui",
                  "select": "Use a shared component from packages/editor-react/src/ui",
                  "textarea": "Use a shared component from packages/editor-react/src/ui",
                  "dialog": "Use a shared component from packages/editor-react/src/ui",
                  "h1": "Use a shared component from packages/editor-react/src/ui",
                  "h2": "Use a shared component from packages/editor-react/src/ui",
                  "h3": "Use a shared component from packages/editor-react/src/ui",
                  "h4": "Use a shared component from packages/editor-react/src/ui",
                  "h5": "Use a shared component from packages/editor-react/src/ui",
                  "h6": "Use a shared component from packages/editor-react/src/ui",
                  "ul": "Use a shared component from packages/editor-react/src/ui",
                  "ol": "Use a shared component from packages/editor-react/src/ui",
                  "li": "Use a shared component from packages/editor-react/src/ui",
                  "img": "Use a shared component from packages/editor-react/src/ui",
                  "label": "Use a shared component from packages/editor-react/src/ui",
                  "p": "Use a shared component from packages/editor-react/src/ui",
                  "span": "Use Text or another shared component from packages/editor-react/src/ui"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/editor-react/src/canvas/ButtonsCard.tsx",
        "packages/editor-react/src/canvas/FieldPalette.tsx",
        "packages/editor-react/src/canvas/MatrixPreview.tsx",
        "packages/editor-react/src/canvas/StepHeaderCard.tsx",
        "packages/editor-react/src/inspector/FieldPanel.tsx",
        "packages/editor-react/src/inspector/ResponseKey.tsx",
        "packages/editor-react/src/inspector/StepPanel.tsx",
        "packages/editor-react/src/logic/LogicSection.tsx",
        "packages/editor-react/src/logic/StepFlow.tsx",
        "packages/editor-react/src/publish/PublishButton.tsx",
        "packages/editor-react/src/publish/PublishControls.tsx",
        "packages/editor-react/src/shell/EditorSaveStatus.tsx",
        "packages/editor-react/src/shell/EditorTopBar.tsx",
        "packages/editor-react/src/shell/EditorView.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "Use a shared component from packages/editor-react/src/ui",
                  "input": "Use a shared component from packages/editor-react/src/ui",
                  "select": "Use a shared component from packages/editor-react/src/ui",
                  "textarea": "Use a shared component from packages/editor-react/src/ui",
                  "dialog": "Use a shared component from packages/editor-react/src/ui",
                  "h1": "Use a shared component from packages/editor-react/src/ui",
                  "h2": "Use a shared component from packages/editor-react/src/ui",
                  "h3": "Use a shared component from packages/editor-react/src/ui",
                  "h4": "Use a shared component from packages/editor-react/src/ui",
                  "h5": "Use a shared component from packages/editor-react/src/ui",
                  "h6": "Use a shared component from packages/editor-react/src/ui",
                  "ul": "Use a shared component from packages/editor-react/src/ui",
                  "ol": "Use a shared component from packages/editor-react/src/ui",
                  "li": "Use a shared component from packages/editor-react/src/ui",
                  "img": "Use a shared component from packages/editor-react/src/ui",
                  "label": "Use a shared component from packages/editor-react/src/ui",
                  "p": "Use a shared component from packages/editor-react/src/ui"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/editor-react/src/canvas/FieldCard.tsx",
        "packages/editor-react/src/canvas/FieldDetails.tsx",
        "packages/editor-react/src/logic/LogicBadge.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "span": "Use Text or another shared component from packages/editor-react/src/ui",
                  "img": "Use Picture from packages/editor-react/src/ui"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/editor-react/src/ui/components/CommandList/CommandOptions.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/react/src/fields/SwitchField.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsForRole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/react/src/FormActions.tsx", "packages/vue/src/FormActions.vue"],
      "linter": {
        "rules": {
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    },
    {
      "includes": ["stylelint.config.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/nuxt/app/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    }
  ]
}
